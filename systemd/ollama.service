[Unit]
Description=Ollama CUDA 12 local inference
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.local/share/ollama-control-tower/models
Environment=OLLAMA_LLM_LIBRARY=cuda_v12
Environment=OLLAMA_KEEP_ALIVE=30m
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=2
Environment=OLLAMA_MAX_QUEUE=16
Environment=OLLAMA_NOPRUNE=true
Environment=OLLAMA_FLASH_ATTENTION=false
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
